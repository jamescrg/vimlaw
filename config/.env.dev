# Safe, credential-free defaults for local development.

# This file is never loaded automatically. Copy it to config/.env before
# starting the app:

# cp config/.env.dev config/.env

# Do not use these values in staging or production.

SECRET_KEY=django-insecure-kosmos-local-development-only-not-for-production
DEBUG=True
ENV=dev
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SITE_NAME=Kosmos Development

DB_NAME=kosmos
DB_USER=kosmos
DB_PASSWORD=kosmos
DB_HOST=localhost
DB_PORT=5432

ADMINS=[]

# Print email to the runserver/qcluster logs instead of delivering it.
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SERVER_EMAIL=webmaster@localhost
DEFAULT_FROM_EMAIL=Kosmos Development <webmaster@localhost>
BILLING_FROM_EMAIL=Kosmos Development <webmaster@localhost>

# Keep uploads on disk and avoid requiring object-storage credentials.
STORAGE_BACKEND=local

# Google integrations remain disabled until local OAuth credentials are added.
GOOGLE_DATA_DIR=google
CALENDAR_ID=
DRIVE_NOTES_ROOT=Matters - Open
DRIVE_NOTES_DEBUG_DIR=
DRIVE_SHARED_DRIVE_ID=
DRIVE_KEY_DOCUMENTS_FOLDER=Key Documents
GMAIL_LABEL_ROOT=Matters - Open

# Optional external integrations are disabled by default.
LAW_FIRM_ID=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COURTLISTENER_API_KEY=
KOSMOS_SEAM_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
INTAKE_INBOUND_RECIPIENT=kosmos-dev-intakes

# Use the non-networked payment implementation locally.
PAYMENT_PROCESSOR=fake
LAWPAY_PUBLIC_KEY=
LAWPAY_SECRET_KEY=
LAWPAY_OPERATING_CARD_ACCOUNT_ID=
LAWPAY_OPERATING_ECHECK_ACCOUNT_ID=
LAWPAY_TRUST_CARD_ACCOUNT_ID=
LAWPAY_TRUST_ECHECK_ACCOUNT_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CONFIDO_API_KEY=
CONFIDO_WEBHOOK_SECRET=
CONFIDO_OPERATING_BANK_ACCOUNT_ID=
CONFIDO_TRUST_BANK_ACCOUNT_ID=

PUBLIC_BASE_URL=http://localhost:8000

# Unused while STORAGE_BACKEND=local; kept here so switching to s3 is obvious.
DIGITAL_OCEAN_REGION_NAME=
DIGITAL_OCEAN_ENDPOINT_URL=
DIGITAL_OCEAN_BUCKET_NAME=
DIGITAL_OCEAN_ACCESS_KEY_ID=
DIGITAL_OCEAN_SECRET_ACCESS_KEY=
